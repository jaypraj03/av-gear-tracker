# ---- Dependencies ----
# Installed by npm; huge and re-creatable from package-lock.json
node_modules/

# ---- Secrets ----
# Database connection strings and API keys live here. NEVER commit these.
.env
.env.*
!.env.example

# ---- Build output ----
# Generated by `npm run build`; CI rebuilds it every time
dist/
build/
coverage/

# ---- Test reports ----
playwright-report/
test-results/

# ---- Logs ----
*.log
npm-debug.log*

# ---- OS / editor files ----
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
