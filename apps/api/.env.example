# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require"

# Optional: enables the AI assistant. Set ONE of these.
# Free: Google Gemini key from https://aistudio.google.com
GEMINI_API_KEY=""
# Paid: Anthropic Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Allows POST /api/demo/reset to restore sample data
DEMO_MODE="true"
