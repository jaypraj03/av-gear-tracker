    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
